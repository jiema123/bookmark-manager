# Cloudflare Workers 本地开发环境变量示例
# 复制此文件为 .dev.vars 并填入实际值

# KV Namespace IDs (从 Cloudflare Dashboard 获取)
# BOOKMARKS_KV_ID=your-kv-namespace-id
# PLAZA_KV_ID=your-plaza-kv-namespace-id

# Gemini API Key
GEMINI_API_KEY=your-gemini-api-key

# Gemini API Base URL (optional)
GEMINI_API_BASE_URL=https://gemini-api.21588.org/v1beta/openai

# Gemini model name (optional)
GEMINI_MODEL=gemini-3-flash-preview
